# Développement uniquement : http://localhost:8080 (port 80 dans le conteneur), sans HTTPS.
{
	auto_https off
	frankenphp
}

:80 {
	root * /app/public

	# Toute URL qui ne correspond pas à un fichier est confiée à Symfony (public/index.php).
	# Contrairement à Apache, l'en-tête Authorization des tablettes est transmis tel quel.
	php_server
}
