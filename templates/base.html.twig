<!DOCTYPE html>
<html lang="fr" data-base-path="{{ app.request.basePath }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>{% block title %}Le Comptoir des étoiles{% endblock %}</title>
        <link rel="icon" href="{{ app.request.basePath }}/img/logo-generique.svg" type="image/svg+xml">
        <link rel="manifest" href="{{ path('app_manifest') }}">
        <link rel="apple-touch-icon" href="{{ app.request.basePath }}/img/app/icon-192.png">
        <meta name="theme-color" content="#A56726" media="(prefers-color-scheme: light)">
        <meta name="theme-color" content="#1A1612" media="(prefers-color-scheme: dark)">
        <link rel="stylesheet" href="{{ app.request.basePath }}/css/tokens.css">
        <link rel="stylesheet" href="{{ app.request.basePath }}/css/base.css">
        <link rel="stylesheet" href="{{ app.request.basePath }}/css/icons.css">
        {% block stylesheets %}{% endblock %}
        <script type="module" src="{{ app.request.basePath }}/js/sw-register.js"></script>
        {% block javascripts %}{% endblock %}
    </head>
    <body class="{% block body_class %}{% endblock %}">
        <header class="site-header">
            <div class="bar wrap">
                <a class="brand" href="{{ path('app_home') }}">
                    {% block brand_logo %}{% endblock %}
                    Le Comptoir des étoiles
                </a>
                <nav aria-label="Navigation principale">
                    {% block nav %}{% endblock %}
                </nav>
            </div>
        </header>

        <main class="wrap{% block main_class %}{% endblock %}">
            {% for type, messages in app.flashes(['info', 'error']) %}
                {% for message in messages %}
                    <p class="alert alert-{{ type }}" role="status">{{ message }}</p>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </body>
</html>
