{% extends 'admin/base.html.twig' %}
{% import 'admin/menu/_macros.html.twig' as m %}

{% block title %}Menu · Administration{% endblock %}

{% block javascripts %}
    <script type="module" src="{{ app.request.basePath }}/js/menu-categories.js"></script>
{% endblock %}

{# Boutons ↑ ↓ : ils envoient tout le tableau, rien de ce qui a été saisi n'est perdu #}
{% macro move_buttons(product, first, last) %}
    <span class="move">
        <button type="submit" form="menu-save" name="move" value="{{ product.id }}:up" class="btn btn-icon" aria-label="Monter « {{ product.name }} »"{{ first ? ' disabled' }}>↑</button>
        <button type="submit" form="menu-save" name="move" value="{{ product.id }}:down" class="btn btn-icon" aria-label="Descendre « {{ product.name }} »"{{ last ? ' disabled' }}>↓</button>
    </span>
{% endmacro %}

{% macro row_inputs(product, v, e, with_stock, with_kitchen, with_alone) %}
    {% import 'admin/menu/_macros.html.twig' as m %}
    {% set prefix = 'products[' ~ product.id ~ ']' %}
    <td data-label="Prix (€)">
        <input type="text" form="menu-save" inputmode="decimal" name="{{ prefix }}[price]" value="{{ v.price }}" class="num input-price" aria-label="Prix de {{ product.name }}"{{ m.invalid(e, 'price') }}>
        {{ m.error(e, 'price') }}
    </td>
    {% if with_stock %}
        <td data-label="Stock de départ">
            <input type="text" form="menu-save" inputmode="numeric" name="{{ prefix }}[stock]" value="{{ v.stock }}" placeholder="non compté" class="num input-price" aria-label="Stock de départ de {{ product.name }}"{{ m.invalid(e, 'stock') }}>
            {{ m.error(e, 'stock') }}
            {% set in_units_text = in_units(product.initialStock, product.purchaseUnit, product.portionsPerUnit) %}
            {% if in_units_text %}<span class="seen">{{ in_units_text }}</span>{% endif %}
        </td>
    {% endif %}
    {% if with_kitchen %}
        <td data-label="Cuisine"><input type="checkbox" form="menu-save" name="{{ prefix }}[kitchen]" value="1" {{ v.kitchen ? 'checked' }} aria-label="{{ product.name }} passe en cuisine"></td>
    {% endif %}
    <td data-label="Consigne"><input type="checkbox" form="menu-save" name="{{ prefix }}[deposit]" value="1" {{ v.deposit ? 'checked' }} aria-label="{{ product.name }} avec consigne"></td>
    {% if with_alone %}
        <td data-label="Vendu seul"><input type="checkbox" form="menu-save" name="{{ prefix }}[alone]" value="1" {{ v.alone ? 'checked' }} aria-label="{{ product.name }} vendu seul"></td>
    {% endif %}
{% endmacro %}

{% block body %}
    <div class="section-head">
        <div>
            <h1>Menu</h1>
            <form method="get" action="{{ path('admin_menu') }}" class="menu-event-picker">
                <label for="menu-event">Menu de :</label>
                <select id="menu-event" name="evenement">
                    {% for e in events %}
                        <option value="{{ e.id }}"{{ e is same as(event) ? ' selected' }}>{{ e.name }} · {{ e.date|date('d/m/Y') }}{{ e.active ? ' · actif' }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn">Afficher</button>
            </form>
            {% if state == 'active' %}
                <p class="menu-state"><span class="pill pill-active">Actif</span> Les tablettes voient les changements tout de suite.</p>
            {% elseif state == 'preparing' %}
                <p class="menu-state"><span class="pill pill-waiting">En préparation</span> Pas encore actif : les tablettes ne voient pas ce menu. <a href="{{ path('admin_event_activate', {id: event.id}) }}">Activer cet événement</a> le moment venu.</p>
            {% else %}
                <p class="menu-state"><span class="pill">Terminé</span> Événement passé, pas actif. Le Carnet de bord de cet événement suit les catégories modifiées ici.</p>
            {% endif %}
            <p class="lede">
                {% if event.depositCents %}Consigne : {{ event.depositCents|euros }} par article « avec consigne ».{% else %}Pas de consigne pour cet événement.{% endif %}
                {% if not event.hasKitchen %}Sans cuisine.{% endif %}
                <a href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier l'événement</a>
            </p>
        </div>
        <a class="btn" href="{{ path('admin_menu_copy', menu_params) }}">Reprendre le menu d'un autre événement</a>
    </div>

    {% if row_errors is not empty %}
        <p class="alert alert-error" role="alert">Rien n'a été enregistré : corrigez les champs signalés en rouge, puis enregistrez à nouveau.</p>
    {% endif %}

    {# Articles #}
    <section class="menu-section" aria-labelledby="articles-title">
        <div class="section-head">
            <div>
                <h2 id="articles-title">Articles</h2>
                <p class="lede">Ce qui se vend à l'unité. Laissez le stock vide pour un article non compté (café, thé…). Décochez « Vendu seul » pour un article vendu seulement dans les formules : il n'apparaît plus sur les caisses, mais son stock est toujours décompté. Les articles sont rangés par catégorie : choisissez-en une dans les onglets. Pour changer la catégorie d'un article, touchez « Modifier ».</p>
            </div>
            <a class="btn" href="{{ path('admin_menu_product_new', menu_params) }}">Ajouter un article</a>
        </div>

        {% if unsellable is not empty %}
            <p class="alert alert-warning" id="unsellable">
                {% for product in unsellable %}« {{ product.name }} »{{ not loop.last ? ', ' }}{% endfor %}
                {{ unsellable|length > 1 ? 'ne sont vendus' : 'n\'est vendu' }} ni seul{{ unsellable|length > 1 ? 's' }} ni dans une formule : {{ unsellable|length > 1 ? 'ils sont invisibles' : 'il est invisible' }} sur les caisses. Cochez « Vendu seul », ou ajoutez-{{ unsellable|length > 1 ? 'les' : 'le' }} à une formule.
            </p>
        {% endif %}

        {% if articles is empty %}
            <div class="card empty">
                <p>Aucun article pour l'instant. Ajoutez vos articles un par un, ou chargez le menu d'exemple du Loto pour tester.</p>
                <form method="post" action="{{ path('admin_menu_example', menu_params) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('menu-example-' ~ event.id) }}">
                    <button type="submit" class="btn">Charger le menu d'exemple du Loto</button>
                </form>
            </div>
        {% else %}
            {# Onglets : une catégorie à la fois (menu-categories.js). Sans JavaScript, tout s'affiche
               et les onglets mènent à chaque catégorie. Les champs cachés restent dans le formulaire :
               changer d'onglet ne perd aucune saisie. #}
            {% if article_groups|length > 1 %}
                <nav class="menu-tabs" aria-label="Catégories">
                    <a href="#categories" class="menu-tab" data-menu-tab="all">Tout <span class="menu-tab-count">{{ articles|length }}</span></a>
                    {% for category, products in article_groups %}
                        <a href="#categorie-{{ loop.index }}" class="menu-tab" data-menu-tab="categorie-{{ loop.index }}">{{ category }} <span class="menu-tab-count">{{ products|length }}</span></a>
                    {% endfor %}
                </nav>
            {% endif %}
            <div id="categories">
            {% for category, products in article_groups %}
                <section class="menu-category" id="categorie-{{ loop.index }}" data-menu-panel aria-labelledby="categorie-{{ loop.index }}-titre">
                    <h3 class="menu-category-title" id="categorie-{{ loop.index }}-titre">{{ category }} <span class="menu-category-count">{{ products|length }} article{{ products|length > 1 ? 's' }}</span></h3>
                    <div class="tablewrap">
                        <table class="menu-table stack-table">
                            <thead>
                                <tr><th>Ordre</th><th>Article</th><th>Prix (€)</th><th>Stock de départ</th>{% if event.hasKitchen %}<th>Cuisine</th>{% endif %}<th>Consigne</th><th>Vendu seul</th><th><span class="visually-hidden">Actions</span></th></tr>
                            </thead>
                            <tbody>
                                {% for product in products %}
                                    {% set e = row_errors[product.id] ?? {} %}
                                    <tr id="produit-{{ product.id }}"{% if e is not empty %} class="row-invalid"{% endif %}>
                                        <td data-label="Ordre">{{ _self.move_buttons(product, loop.first, loop.last) }}</td>
                                        <td class="stack-title">
                                            <span class="product-name"><span class="{{ icon_class(product.icon) }}" aria-hidden="true"></span> {{ product.name }}</span>
                                        </td>
                                        {{ _self.row_inputs(product, row_values[product.id], e, true, event.hasKitchen, true) }}
                                        <td class="actions"><a class="btn btn-small" href="{{ path('admin_menu_edit', {id: product.id}) }}">Modifier</a></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            {% endfor %}
            </div>
        {% endif %}
    </section>

    {# Formules #}
    <section class="menu-section" aria-labelledby="formulas-title">
        <div class="section-head">
            <div>
                <h2 id="formulas-title">Formules</h2>
                <p class="lede">Plusieurs articles vendus ensemble à un prix donné. Leur stock se déduit de celui de leurs articles.</p>
            </div>
            {% if articles is not empty %}
                <a class="btn" href="{{ path('admin_menu_formula_new', menu_params) }}">Créer une formule</a>
            {% endif %}
        </div>

        {% if formulas is empty %}
            <p class="card empty">Aucune formule.{% if articles is empty %} Ajoutez d'abord des articles : une formule se compose d'articles existants.{% endif %}</p>
        {% else %}
            <div class="tablewrap">
                <table class="menu-table stack-table">
                    <thead>
                        <tr><th>Ordre</th><th>Formule</th><th>Prix (€)</th>{% if event.hasKitchen %}<th>Cuisine</th>{% endif %}<th>Consigne</th><th><span class="visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        {% for product in formulas %}
                            {% set e = row_errors[product.id] ?? {} %}
                            <tr id="produit-{{ product.id }}"{% if e is not empty %} class="row-invalid"{% endif %}>
                                <td data-label="Ordre">{{ _self.move_buttons(product, loop.first, loop.last) }}</td>
                                <td class="stack-title">
                                    <span class="product-name"><span class="{{ icon_class(product.icon) }}" aria-hidden="true"></span> {{ product.name }}</span>
                                    <span class="seen">{{ product.describeComposition }}</span>
                                </td>
                                {{ _self.row_inputs(product, row_values[product.id], e, false, event.hasKitchen, false) }}
                                <td class="actions"><a class="btn btn-small" href="{{ path('admin_menu_edit', {id: product.id}) }}">Modifier</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {% if articles is not empty %}
        {# Les champs du tableau sont rattachés à ce formulaire par leur attribut form #}
        <form method="post" action="{{ path('admin_menu_save', menu_params) }}" id="menu-save" class="menu-save" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('menu-save-' ~ event.id) }}">
            <button type="submit" class="btn btn-primary">Enregistrer le menu</button>
        </form>
    {% endif %}
{% endblock %}
