{% extends 'admin/base.html.twig' %}
{% import 'admin/menu/_macros.html.twig' as m %}

{% block title %}Menu · Administration{% endblock %}

{# Boutons ↑ ↓ : ils envoient tout le tableau, rien de ce qui a été saisi n'est perdu #}
{% macro move_buttons(product, first, last) %}
    <span class="move">
        <button type="submit" form="menu-save" name="move" value="{{ product.id }}:up" class="btn btn-icon" aria-label="Monter « {{ product.name }} »"{{ first ? ' disabled' }}>↑</button>
        <button type="submit" form="menu-save" name="move" value="{{ product.id }}:down" class="btn btn-icon" aria-label="Descendre « {{ product.name }} »"{{ last ? ' disabled' }}>↓</button>
    </span>
{% endmacro %}

{% macro row_inputs(product, v, e, with_stock) %}
    {% import 'admin/menu/_macros.html.twig' as m %}
    {% set prefix = 'products[' ~ product.id ~ ']' %}
    <td data-label="Prix (€)">
        <input type="text" form="menu-save" inputmode="decimal" name="{{ prefix }}[price]" value="{{ v.price }}" class="num input-price" aria-label="Prix de {{ product.name }}"{{ m.invalid(e, 'price') }}>
        {{ m.error(e, 'price') }}
    </td>
    {% if with_stock %}
        <td data-label="Stock de départ">
            <input type="text" form="menu-save" inputmode="numeric" name="{{ prefix }}[stock]" value="{{ v.stock }}" placeholder="non compté" class="num input-price" aria-label="Stock de départ de {{ product.name }}"{{ m.invalid(e, 'stock') }}>
            {{ m.error(e, 'stock') }}
        </td>
    {% endif %}
    <td data-label="Cuisine"><input type="checkbox" form="menu-save" name="{{ prefix }}[kitchen]" value="1" {{ v.kitchen ? 'checked' }} aria-label="{{ product.name }} passe en cuisine"></td>
    <td data-label="Consigne"><input type="checkbox" form="menu-save" name="{{ prefix }}[deposit]" value="1" {{ v.deposit ? 'checked' }} aria-label="{{ product.name }} avec consigne"></td>
{% endmacro %}

{% block body %}
    <div class="section-head">
        <div>
            <h1>Menu</h1>
            <p class="lede">
                Articles de l'événement « {{ event.name }} ».
                {% if event.depositCents %}Consigne : {{ event.depositCents|euros }} par article « avec consigne ».{% else %}Pas de consigne pour cet événement.{% endif %}
                <a href="{{ path('admin_event_edit', {id: event.id}) }}">Modifier</a>
            </p>
        </div>
    </div>

    {% if row_errors is not empty %}
        <p class="alert alert-error" role="alert">Rien n'a été enregistré : corrigez les champs signalés en rouge, puis enregistrez à nouveau.</p>
    {% endif %}

    {# Articles #}
    <section class="menu-section" aria-labelledby="articles-title">
        <div class="section-head">
            <div>
                <h2 id="articles-title">Articles</h2>
                <p class="lede">Ce qui se vend à l'unité. Laissez le stock vide pour un article non compté (café, thé…).</p>
            </div>
            <a class="btn" href="{{ path('admin_menu_product_new') }}">Ajouter un article</a>
        </div>

        {% if articles is empty %}
            <div class="card empty">
                <p>Aucun article pour l'instant. Ajoutez vos articles un par un, ou chargez le menu d'exemple du Loto pour tester.</p>
                <form method="post" action="{{ path('admin_menu_example') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('menu-example') }}">
                    <button type="submit" class="btn">Charger le menu d'exemple du Loto</button>
                </form>
            </div>
        {% else %}
            <div class="tablewrap">
                <table class="menu-table stack-table">
                    <thead>
                        <tr><th>Ordre</th><th>Article</th><th>Prix (€)</th><th>Stock de départ</th><th>Cuisine</th><th>Consigne</th><th><span class="visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        {% for product in articles %}
                            {% set e = row_errors[product.id] ?? {} %}
                            <tr id="produit-{{ product.id }}"{% if e is not empty %} class="row-invalid"{% endif %}>
                                <td data-label="Ordre">{{ _self.move_buttons(product, loop.first, loop.last) }}</td>
                                <td class="stack-title">
                                    <span class="product-name"><span class="{{ icon_class(product.icon) }}" aria-hidden="true"></span> {{ product.name }}</span>
                                    <span class="seen">{{ product.category }}</span>
                                </td>
                                {{ _self.row_inputs(product, row_values[product.id], e, true) }}
                                <td class="actions"><a class="btn btn-small" href="{{ path('admin_menu_edit', {id: product.id}) }}">Modifier</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {# Formules #}
    <section class="menu-section" aria-labelledby="formulas-title">
        <div class="section-head">
            <div>
                <h2 id="formulas-title">Formules</h2>
                <p class="lede">Plusieurs articles vendus ensemble à un prix donné. Leur stock se déduit de celui de leurs articles.</p>
            </div>
            {% if articles is not empty %}
                <a class="btn" href="{{ path('admin_menu_formula_new') }}">Créer une formule</a>
            {% endif %}
        </div>

        {% if formulas is empty %}
            <p class="card empty">Aucune formule.{% if articles is empty %} Ajoutez d'abord des articles : une formule se compose d'articles existants.{% endif %}</p>
        {% else %}
            <div class="tablewrap">
                <table class="menu-table stack-table">
                    <thead>
                        <tr><th>Ordre</th><th>Formule</th><th>Prix (€)</th><th>Cuisine</th><th>Consigne</th><th><span class="visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        {% for product in formulas %}
                            {% set e = row_errors[product.id] ?? {} %}
                            <tr id="produit-{{ product.id }}"{% if e is not empty %} class="row-invalid"{% endif %}>
                                <td data-label="Ordre">{{ _self.move_buttons(product, loop.first, loop.last) }}</td>
                                <td class="stack-title">
                                    <span class="product-name"><span class="{{ icon_class(product.icon) }}" aria-hidden="true"></span> {{ product.name }}</span>
                                    <span class="seen">{{ product.describeComposition }}</span>
                                </td>
                                {{ _self.row_inputs(product, row_values[product.id], e, false) }}
                                <td class="actions"><a class="btn btn-small" href="{{ path('admin_menu_edit', {id: product.id}) }}">Modifier</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>

    {% if articles is not empty %}
        {# Les champs du tableau sont rattachés à ce formulaire par leur attribut form #}
        <form method="post" action="{{ path('admin_menu_save') }}" id="menu-save" class="menu-save" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('menu-save') }}">
            <button type="submit" class="btn btn-primary">Enregistrer le menu</button>
        </form>
    {% endif %}
{% endblock %}
