{% extends 'admin/base.html.twig' %}
{% import 'admin/menu/_macros.html.twig' as m %}

{% set title = is_new ? 'Ajouter un article' : 'Modifier « ' ~ product.name ~ ' »' %}
{% block title %}{{ title }} · Administration{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_menu', menu_params) }}">← Retour au menu</a></p>

    <section class="card form-card menu-form">
        <h1>{{ title }}</h1>
        {% if not event.active %}<p class="lede">Menu de « {{ event.name }} », pas encore actif.</p>{% endif %}
        {% if errors is not empty %}
            <p class="alert alert-error" role="alert">L'article n'est pas enregistré : corrigez les champs signalés.</p>
        {% endif %}

        <form method="post" novalidate>
            <div class="field">
                <label for="name">Nom</label>
                <input type="text" id="name" name="name" value="{{ values.name }}" maxlength="80" placeholder="Crêpe sucre" required{{ m.invalid(errors, 'name') }}>
                {{ m.error(errors, 'name') }}
            </div>

            {{ include('admin/menu/_icon_picker.html.twig', {selected: values.icon, error: errors.icon ?? null}) }}

            <div class="field">
                <label for="category">Catégorie</label>
                <input type="text" id="category" name="category" value="{{ values.category }}" maxlength="40" list="categories" placeholder="Divers" aria-describedby="category-help"{{ m.invalid(errors, 'category') }}>
                <datalist id="categories">
                    {% for category in categories %}<option value="{{ category }}"></option>{% endfor %}
                </datalist>
                <p class="field-help" id="category-help">Les articles sont regroupés par catégorie sur la caisse. Choisissez-en une existante ou tapez-en une nouvelle.</p>
                {{ m.error(errors, 'category') }}
            </div>

            <div class="field-row">
                <div class="field">
                    <label for="price">Prix (€)</label>
                    <input type="text" id="price" name="price" value="{{ values.price }}" inputmode="decimal" class="num" placeholder="1,50"{{ m.invalid(errors, 'price') }}>
                    {{ m.error(errors, 'price') }}
                </div>
                <div class="field">
                    <label for="stock">Stock de départ</label>
                    <input type="text" id="stock" name="stock" value="{{ values.stock }}" inputmode="numeric" class="num" placeholder="non compté" aria-describedby="stock-help"{{ m.invalid(errors, 'stock') }}>
                    {{ m.error(errors, 'stock') }}
                </div>
            </div>
            <p class="field-help" id="stock-help">Laissez le stock vide pour un article non compté (café, thé…). Le stock sert d'information : il ne bloque jamais une vente.</p>

            <div class="field-row">
                <div class="field">
                    <label for="unit">Unité d'achat</label>
                    <input type="text" id="unit" name="unit" value="{{ values.unit }}" maxlength="40" placeholder="pot de Nutella" aria-describedby="unit-help"{{ m.invalid(errors, 'unit') }}>
                    {{ m.error(errors, 'unit') }}
                </div>
                <div class="field">
                    <label for="portions">Portions par unité</label>
                    <input type="text" id="portions" name="portions" value="{{ values.portions }}" inputmode="numeric" class="num" placeholder="25" aria-describedby="unit-help"{{ m.invalid(errors, 'portions') }}>
                    {{ m.error(errors, 'portions') }}
                </div>
            </div>
            <p class="field-help" id="unit-help">
                Facultatif, pour préparer les courses : un pot de Nutella fait 25 crêpes. Le stock reste compté en portions ; le Carnet de bord indique aussi ce qui reste en unités d'achat.
                {% set in_units_text = in_units(product.initialStock, product.purchaseUnit, product.portionsPerUnit) %}
                {% if in_units_text %}<br>Stock de départ enregistré : {{ product.initialStock }} portions {{ in_units_text }}.{% endif %}
            </p>

            {% if event.hasKitchen %}
                <label class="check"><input type="checkbox" name="kitchen" value="1" {{ values.kitchen ? 'checked' }}> Passe en cuisine</label>
            {% endif %}
            <label class="check"><input type="checkbox" name="deposit" value="1" {{ values.deposit ? 'checked' }}> Avec consigne{% if event.depositCents %} ({{ event.depositCents|euros }}){% endif %}</label>
            <label class="check"><input type="checkbox" name="alone" value="1" {{ values.alone ? 'checked' }} aria-describedby="alone-help"> Vendu seul</label>
            <p class="field-help" id="alone-help">Décochez pour un article vendu seulement dans les formules (saucisse d'un menu…) : il n'apparaît plus sur les caisses, mais son stock est toujours décompté.</p>

            <input type="hidden" name="_token" value="{{ csrf_token('menu-product-' ~ (product.id ?? ('new-' ~ event.id))) }}">
            <div class="form-actions">
                <a class="btn" href="{{ path('admin_menu', menu_params) }}">Annuler</a>
                <button type="submit" class="btn btn-primary">{{ is_new ? 'Ajouter l\'article' : 'Enregistrer l\'article' }}</button>
            </div>
        </form>

        {% if not is_new %}
            <p class="form-footer">
                {% if used_as_component %}Cet article fait partie d'au moins une formule. {% endif %}
                <a href="{{ path('admin_menu_remove', {id: product.id}) }}">Retirer cet article du menu</a>
            </p>
        {% endif %}
    </section>
{% endblock %}
