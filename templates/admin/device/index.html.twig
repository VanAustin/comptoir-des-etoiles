{% extends 'admin/base.html.twig' %}

{% block title %}Tablettes · Administration{% endblock %}

{% set state_labels = {
    waiting: ['En attente d\'appairage', 'pill-waiting'],
    code_expired: ['Code expiré', ''],
    paired: ['Appairée', 'pill-active'],
    expired: ['Expirée', ''],
    revoked: ['Révoquée', 'pill-revoked'],
} %}

{% block body %}
    {% if event is null %}
        <h1>Tablettes</h1>
        <p class="card empty">Aucun événement n'est actif. Les tablettes sont rattachées à l'événement actif : <a href="{{ path('admin_event_index') }}">activez d'abord un événement</a>.</p>
    {% else %}
        <div class="section-head">
            <div>
                <h1>Tablettes</h1>
                <p class="lede">Tablettes de l'événement « {{ event.name }} ». Elles cessent de fonctionner le lendemain de l'événement à 6 h.</p>
            </div>
            <a class="btn btn-primary" href="{{ path('admin_device_new') }}">Ajouter une tablette</a>
        </div>

        {% if unsold_categories is not empty %}
            <p class="alert alert-warning" id="unsold-categories">
                Aucune caisse ne vend {{ unsold_categories|length > 1 ? 'les catégories' : 'la catégorie' }}
                {% for category in unsold_categories %}« {{ category }} »{{ not loop.last ? ', ' }}{% endfor %} :
                {{ unsold_categories|length > 1 ? 'elles ne peuvent' : 'elle ne peut' }} pas être encaissée{{ unsold_categories|length > 1 ? 's' }}. Cochez-{{ unsold_categories|length > 1 ? 'les' : 'la' }} dans les « Réglages » d'une caisse.
            </p>
        {% endif %}

        {% if revoked_count > 0 %}
            <p class="revoked-toggle">
                {% if show_revoked %}
                    <a href="{{ path('admin_device_index') }}">Masquer les tablettes retirées ({{ revoked_count }})</a>
                {% else %}
                    <a href="{{ path('admin_device_index', {retirees: 1}) }}">Afficher les tablettes retirées ({{ revoked_count }})</a>
                {% endif %}
            </p>
        {% endif %}

        {% if devices is empty %}
            <p class="card empty">
                {%- if revoked_count > 0 -%}
                    Aucune tablette en service. Ajoutez-en une, par exemple « Caisse buvette ».
                {%- else -%}
                    Aucune tablette pour l'instant. Ajoutez la première, par exemple « Caisse buvette ».
                {%- endif -%}
            </p>
        {% else %}
            <div class="tablewrap">
                <table class="stack-table">
                    <thead>
                        <tr><th>Tablette</th><th>Rôle</th><th>Lettre</th><th>Vend</th><th>État</th><th><span class="visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                        {% for device in devices %}
                            {% set state = states[device.id] %}
                            <tr>
                                <td class="stack-title">{{ device.name }}</td>
                                <td data-label="Rôle">{{ device.role.label }}</td>
                                <td class="num" data-label="Lettre">{{ device.tillLetter ?? '—' }}</td>
                                <td data-label="Vend">
                                    {% if device.role.value == 'caisse' %}
                                        {{ device.categories is empty ? 'Tout le menu' : device.categories|join(', ') }}
                                        {% if device.directSale %}<span class="seen">vente directe</span>{% endif %}
                                    {% else %}—{% endif %}
                                </td>
                                <td data-label="État">
                                    <span class="pill {{ state_labels[state][1] }}">{{ state_labels[state][0] }}</span>
                                    {% if state == 'paired' %}
                                        <span class="seen">{{ device.lastSeenAt ? 'vue à ' ~ device.lastSeenAt|date('H\\hi') : 'pas encore vue' }}</span>
                                    {% endif %}
                                </td>
                                <td class="actions">
                                    {% if device.role.value == 'caisse' and state != 'revoked' %}
                                        <a class="btn btn-small" href="{{ path('admin_device_settings', {id: device.id}) }}">Réglages</a>
                                    {% endif %}
                                    {% if state in ['waiting', 'code_expired'] %}
                                        <form class="inline-form" method="post" action="{{ path('admin_device_regenerate', {id: device.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('device-regenerate-' ~ device.id) }}">
                                            <button type="submit" class="btn btn-small">Nouveau code</button>
                                        </form>
                                    {% endif %}
                                    {% if state != 'revoked' %}
                                        <form class="inline-form" method="post" action="{{ path('admin_device_revoke', {id: device.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('device-revoke-' ~ device.id) }}">
                                            <button type="submit" class="btn btn-small">Révoquer</button>
                                        </form>
                                    {% endif %}
                                    {% if deletable[device.id] is defined %}
                                        <a class="btn btn-small" href="{{ path('admin_device_delete', {id: device.id}) }}">Supprimer</a>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    {% endif %}
{% endblock %}
