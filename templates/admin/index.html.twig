{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Administration</h1>
    <p class="lede">Préparez ici vos événements. Les rubriques arrivent au fil des prochaines versions.</p>

    <div class="tiles">
        <a class="card tile" href="{{ path('admin_event_index') }}">
            <strong>Événements</strong>
            <span>Créer un événement et choisir celui qui est actif.</span>
        </a>
        <div class="card tile" aria-disabled="true">
            <strong>Menu</strong>
            <span>Bientôt disponible.</span>
        </div>
        <a class="card tile" href="{{ path('admin_device_index') }}">
            <strong>Tablettes</strong>
            <span>Ajouter une tablette, l'appairer, la révoquer.</span>
        </a>
    </div>
{% endblock %}
