{% extends 'admin/base.html.twig' %}

{% set heading = event ? 'Modifier « ' ~ event.name ~ ' »' : 'Créer un événement' %}

{% block title %}{{ heading }} · Administration{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script type="module" src="{{ app.request.basePath }}/js/admin-event.js"></script>
{% endblock %}

{% block body %}
    <p><a href="{{ path('admin_event_index') }}">← Retour aux événements</a></p>

    <section class="card form-card">
        <h1>{{ heading }}</h1>

        {% if errors is not empty %}
            <p class="alert alert-error" role="alert">Le formulaire contient des erreurs : corrigez les champs signalés.</p>
        {% endif %}

        <form method="post" novalidate>
            <div class="field">
                <label for="name">Nom de l'événement</label>
                <input type="text" id="name" name="name" value="{{ values.name }}" maxlength="100" required
                       {% if errors.name is defined %}aria-invalid="true" aria-describedby="name-error"{% endif %}>
                {% if errors.name is defined %}<p class="field-error" id="name-error">{{ errors.name }}</p>{% endif %}
            </div>
            <div class="field">
                <label for="date">Date</label>
                <input type="date" id="date" name="date" value="{{ values.date }}" required
                       {% if errors.date is defined %}aria-invalid="true" aria-describedby="date-error"{% endif %}>
                {% if errors.date is defined %}<p class="field-error" id="date-error">{{ errors.date }}</p>{% endif %}
            </div>
            <div class="field">
                <label for="deposit">Montant de la consigne (€)</label>
                <input type="text" id="deposit" name="deposit" value="{{ values.deposit }}" inputmode="decimal" class="num input-short"
                       aria-describedby="deposit-help{% if errors.deposit is defined %} deposit-error{% endif %}"
                       {% if errors.deposit is defined %}aria-invalid="true"{% endif %}>
                <p class="field-help" id="deposit-help">Par écocup ou gobelet, ajouté automatiquement aux articles « avec consigne ». 0 si pas de consigne.</p>
                {% if errors.deposit is defined %}<p class="field-error" id="deposit-error">{{ errors.deposit }}</p>{% endif %}
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" name="with_kitchen" value="1" id="with-kitchen" {{ values.kitchen ? 'checked' }}
                       {{ kitchen_locked ? 'disabled' }} aria-describedby="kitchen-help{{ kitchen_devices is not empty and not (kitchen_locked and event.hasKitchen) ? ' kitchen-devices' }}"> Avec cuisine</label>
                {% if kitchen_locked %}
                    {# Bien visible : une case grisée sans explication passe pour une panne #}
                    <p class="alert alert-warning" id="kitchen-help">
                        Cet événement a déjà {{ order_count }} commande{{ order_count > 1 ? 's' }} : « Avec cuisine » ne peut plus être modifié, pour ne pas fausser les commandes déjà passées.
                        Pour un autre réglage, créez un nouvel événement.
                    </p>
                {% else %}
                    <p class="field-help" id="kitchen-help">
                        Décochez pour un stand sans préparation : chaque commande est servie directement au comptoir, et seules les tablettes caisse fonctionnent.
                    </p>
                {% endif %}
                {# Avec cuisine et déjà des commandes : la case ne peut plus être décochée, rien à annoncer #}
                {% set kitchen_devices_notice = kitchen_devices is not empty and not (kitchen_locked and event.hasKitchen) %}
                {% if kitchen_devices_notice %}
                    <p class="alert alert-warning" id="kitchen-devices">
                        {% if event.hasKitchen %}
                            Si vous décochez « Avec cuisine », {{ kitchen_devices_text }} ne {{ kitchen_devices|length > 1 ? 'fonctionneront' : 'fonctionnera' }} plus.
                        {% else %}
                            Sans cuisine, {{ kitchen_devices_text }} ne {{ kitchen_devices|length > 1 ? 'fonctionnent' : 'fonctionne' }} pas. Révoquez-{{ kitchen_devices|length > 1 ? 'les' : 'la' }} dans Tablettes{{ kitchen_locked ? '' : ', ou cochez « Avec cuisine »' }}.
                        {% endif %}
                    </p>
                {% endif %}
            </div>
            <div class="field">
                <label class="check"><input type="checkbox" name="table_service" value="1" id="table-service" {{ values.table ? 'checked' }}
                       {{ not values.kitchen ? 'disabled' }} aria-describedby="table-help table-blocked"> Service à table</label>
                <p class="field-help" id="table-help">
                    Le client commande et paie à la caisse, donne son numéro de table, et un bénévole lui apporte son plat. Les boissons sont toujours remises au comptoir. Seulement avec « Avec cuisine ».
                </p>
                {# Pourquoi la case est grisée ; admin-event.js le masque dès que « Avec cuisine » est cochée #}
                <p class="field-help table-blocked" id="table-blocked" data-table-blocked{{ values.kitchen ? ' hidden' }}>
                    {%- if kitchen_locked -%}
                        Impossible : l'événement est sans cuisine et a déjà des commandes.
                    {%- else -%}
                        Cochez d'abord « Avec cuisine ».
                    {%- endif -%}
                </p>
            </div>
            <div class="field">
                <label for="rows-per-zone">Rangées par zone de livreur</label>
                <input type="text" id="rows-per-zone" name="rows_per_zone" value="{{ values.zones }}" inputmode="numeric" maxlength="1" class="input-short num"
                       aria-describedby="zones-help{{ errors.zones is defined ? ' zones-error' }}"{{ errors.zones is defined ? ' aria-invalid="true"' }}>
                <p class="field-help" id="zones-help">
                    Service à table : la rangée est le premier chiffre du numéro de table (304 : rangée 3). Avec 3, les rangées 1 à 3 forment la zone 1, 4 à 6 la zone 2, 7 à 9 la zone 3. La cuisine affiche la zone sur chaque ticket, pour le livreur. De 1 à 9.
                </p>
                {% if errors.zones is defined %}<p class="field-error" id="zones-error">{{ errors.zones }}</p>{% endif %}
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('event-form') }}">
            <button type="submit" class="btn btn-primary">{{ event ? 'Enregistrer l\'événement' : 'Créer l\'événement' }}</button>
        </form>
    </section>
{% endblock %}
