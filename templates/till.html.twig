{% extends 'base.html.twig' %}

{% block title %}Caisse · Le Comptoir des étoiles{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ app.request.basePath }}/css/till.css">
{% endblock %}

{% block javascripts %}
    <script type="module" src="{{ app.request.basePath }}/js/till.js"></script>
{% endblock %}

{% block nav %}
    <span class="who" id="till-who"></span>
    <button type="button" class="btn btn-small track-summary" id="till-track" hidden>Suivi</button>
    <a class="btn btn-small" href="{{ path('app_pair') }}">Tablette</a>
{% endblock %}

{% block body_class %}page-wide{% endblock %}

{% block main_class %} till{% endblock %}

{# Aucune donnée dans la page : tout vient de l'API, avec le jeton de la tablette. #}
{% block body %}
    <section id="till-status" class="card till-status">
        <p id="till-status-text" role="status">Chargement du menu…</p>
        <a id="till-status-link" class="btn" href="{{ path('app_pair') }}" hidden>Appairer cette tablette</a>
        <button type="button" id="till-status-retry" class="btn" hidden>Réessayer</button>
        <noscript><p class="alert alert-error">Cette page a besoin de JavaScript. Ouvrez-la dans Chrome.</p></noscript>
    </section>

    <section id="till-main" class="pos" hidden>
        <div>
            <div class="cats" id="till-cats" role="group" aria-label="Catégories"></div>
            <div class="grid" id="till-grid"></div>
            <p id="till-empty-menu" class="card empty" hidden>Le menu est vide. Ajoutez des articles dans l'administration, rubrique Menu, puis touchez « Tablette » et revenez à la caisse.</p>
        </div>

        {# Téléphone : rappel de la commande en bas de l'écran, la commande complète est sous la grille #}
        <div class="cart-mini" id="till-mini" hidden>
            <span class="num" id="till-mini-text"></span>
            <a class="btn btn-small" href="#cart-title">Voir la commande</a>
        </div>

        <aside class="cart" aria-labelledby="cart-title">
            <div class="cart-head">
                <h2 id="cart-title">Commande en cours</h2>
                <span class="next-number num" id="till-next"></span>
            </div>
            <div class="lines" id="till-lines"></div>
            <button type="button" class="btn btn-small" id="till-add-return" hidden>Retour de consigne</button>
            {# Seulement si la commande passe en cuisine #}
            <div class="field note-field" id="till-note-field" hidden>
                <label for="till-note">Remarque pour la cuisine (facultatif)</label>
                <input type="text" id="till-note" maxlength="140" autocomplete="off" placeholder="Sans oignons, bien cuit…" aria-describedby="till-note-help">
                <p class="field-help" id="till-note-help">Pas de nom ni de téléphone. <span class="num" id="till-note-count">0/140</span></p>
            </div>
            <p id="till-cart-error" class="alert alert-error" role="alert" hidden></p>
            <div class="total"><span>Total</span><span class="num" id="till-total"></span></div>
            <div class="row">
                <button type="button" class="btn" id="till-clear">Vider</button>
                <button type="button" class="btn btn-primary" id="till-checkout">Encaisser</button>
            </div>
        </aside>
    </section>

    <section id="till-pay" class="card panel" aria-labelledby="pay-title" hidden>
        <h2 id="pay-title">Paiement</h2>
        <p class="big num" id="pay-total"></p>

        <div class="row segmented" role="group" aria-label="Moyen de paiement">
            <button type="button" class="btn" data-method="cash" aria-pressed="true">Espèces</button>
            <button type="button" class="btn" data-method="card" aria-pressed="false">Carte bancaire</button>
        </div>

        <div id="pay-cash">
            <button type="button" class="btn exact" data-exact aria-pressed="false">Compte juste</button>
            {# Les billets et pièces s'additionnent : 20 € puis 5 € donnent 25 € reçus #}
            <div class="cash" role="group" aria-label="Billets reçus">
                {% for euros in [50, 20, 10, 5] %}
                    <button type="button" class="note num" data-cents="{{ euros * 100 }}" aria-label="Ajouter un billet de {{ euros }} €">{{ euros }} €</button>
                {% endfor %}
            </div>
            <div class="cash coins" role="group" aria-label="Pièces reçues">
                {% for euros in [2, 1] %}
                    <button type="button" class="coin num" data-cents="{{ euros * 100 }}" aria-label="Ajouter une pièce de {{ euros }} €">{{ euros }} €</button>
                {% endfor %}
            </div>
            <div class="received" id="pay-received" hidden>
                <span>Reçu · <span class="num" id="pay-received-detail"></span></span>
                <button type="button" class="btn btn-small" id="pay-clear">Effacer</button>
            </div>
            <p class="lede" id="pay-cash-help">Touchez les billets et pièces donnés par le client, ou « Compte juste ».</p>
        </div>
        <p class="lede" id="pay-card-help" hidden>Passez la carte sur votre terminal, puis validez ici une fois le paiement accepté.</p>
        <p class="lede" id="pay-refund-help" hidden>Le client rend des gobelets : rendez-lui l'argent en espèces.</p>

        <div class="change" id="pay-change" role="status" hidden>
            <span class="change-label" id="pay-change-label"></span>
            <span class="change-amount num" id="pay-change-amount"></span>
            <span class="change-breakdown num" id="pay-change-breakdown"></span>
        </div>
        <p id="pay-error" class="alert alert-error" role="alert" hidden></p>

        <div class="row">
            <button type="button" class="btn" id="pay-back">Retour</button>
            <button type="button" class="btn btn-primary num" id="pay-confirm">Valider</button>
        </div>
    </section>

    <section id="till-track-view" class="card panel track" aria-labelledby="track-title" hidden>
        <div class="track-head">
            <h2 id="track-title">Suivi des commandes</h2>
            <button type="button" class="btn" id="track-close">Revenir à la caisse</button>
        </div>
        <div class="field">
            <label for="track-search">Rechercher un numéro</label>
            <input type="text" id="track-search" autocomplete="off" autocapitalize="characters" class="num" placeholder="A12">
        </div>
        <p id="track-offline" class="alert alert-error" role="status" hidden>Connexion perdue : le suivi n'est peut-être plus à jour.</p>

        <h3>Prêtes · à remettre au client</h3>
        <ul class="track-list" id="track-ready"></ul>
        <p class="empty" id="track-ready-none">Aucune commande prête.</p>

        <h3>En cuisine</h3>
        <ul class="track-list" id="track-kitchen"></ul>
        <p class="empty" id="track-kitchen-none">Rien en cuisine.</p>
    </section>

    <section id="till-done" class="card panel ordernum" aria-labelledby="done-lede" hidden>
        <p class="lede" id="done-lede"></p>
        <p class="n num" id="done-number"></p>
        <p id="done-help"></p>
        <p class="lede" id="done-queue" hidden></p>
        <div class="change" id="done-change" hidden>
            <span class="change-label" id="done-change-label"></span>
            <span class="change-amount num" id="done-change-amount"></span>
            <span class="change-breakdown num" id="done-change-breakdown"></span>
        </div>
        <button type="button" class="btn btn-primary" id="done-next">Commande suivante</button>
    </section>
{% endblock %}
