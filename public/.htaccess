# Configuration Apache, la même en production et en développement (Docker, docker/apache.conf).
# Le site doit être servi depuis ce dossier public/, jamais depuis la racine du projet.

DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTPS obligatoire : sans lui, pas de mode hors ligne sur les tablettes.
    # X-Forwarded-Proto : le HTTPS est parfois assuré par un proxy placé devant Apache.
    # Sauf en développement (http://localhost:8080) : docker/apache.conf définit COMPTOIR_DEV.
    <IfDefine !COMPTOIR_DEV>
        RewriteCond %{HTTPS} !=on
        RewriteCond %{HTTP:X-Forwarded-Proto} !=https
        RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
    </IfDefine>

    # Apache ne transmet pas l'en-tête Authorization à PHP par défaut :
    # sans cette règle, le jeton des tablettes (Authorization: Bearer) n'arrive jamais.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Toute URL qui ne correspond pas à un fichier est confiée à Symfony
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    # Sans mod_rewrite : pas de redirection vers le HTTPS, à activer chez l'hébergeur
    SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
    FallbackResource /index.php
</IfModule>
