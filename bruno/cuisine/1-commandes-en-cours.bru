meta {
  name: 1. Commandes en cours
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_cuisine}}
}

script:post-response {
  // La plus ancienne commande en cours, pour « 2. Faire avancer la commande »
  if (res.status === 200 && res.body.orders.length > 0) {
    bru.setVar("kitchenOrderUuid", res.body.orders[0].uuid);
    bru.setVar("kitchenOrderStatus", res.body.orders[0].status);
  }
  // Pour « 3. Rien de neuf (304) »
  bru.setVar("kitchenEtag", res.headers.etag);
}

tests {
  test("la liste est renvoyée (200)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.orders).to.be.an("array");
  });

  test("l'heure du serveur est dans l'en-tête Date, plus dans le contenu", function () {
    expect(Date.parse(res.headers.date)).to.be.a("number").and.not.NaN;
    expect(res.body).to.not.have.property("serverTime");
  });

  test("seulement des commandes en cours, sans montant", function () {
    res.body.orders.forEach(function (o) {
      expect(["new", "prep", "ready"]).to.include(o.status);
      expect(o.kitchenLines).to.be.an("array");
      expect(o.counterLines).to.be.an("array");
      expect(o).to.not.have.property("totalCents");
    });
  });

  test("zone du livreur : seulement pour une commande à table avec rangée", function () {
    res.body.orders.forEach(function (o) {
      expect(o).to.have.property("zone");
      if (o.tableNumber === null || o.tableNumber < 100) {
        expect(o.zone).to.equal(null);
      } else {
        expect(o.zone).to.be.a("number").and.to.be.at.least(1);
      }
    });
  });

  test("une empreinte permet de répondre « rien de neuf », jamais gardée par un intermédiaire", function () {
    expect(res.headers.etag).to.match(/^"e\d+-o\d+-m\d+-v\d+(-gzip)?"$/);
    expect(res.headers["cache-control"]).to.equal("no-cache, private");
  });
}

docs {
  Liste complète des commandes en cours (nouvelle, en préparation, prête), de la plus ancienne à la plus récente. La tablette cuisine l'interroge toutes les 3 secondes (2 secondes pendant les 30 secondes qui suivent un changement).

  L'empreinte (`ETag`) est faite des numéros de révision de l'événement. Renvoyée dans `If-None-Match`, le serveur répond 304 sans contenu tant que rien n'a changé, sans relire les commandes (« 3. Rien de neuf »). L'heure du serveur, pour les temps d'attente, est dans l'en-tête `Date`.

  Nécessite une tablette **cuisine** appairée et au moins une commande avec un article cuisine (« Caisse / 2. Créer une commande », ou l'écran Caisse).
}
