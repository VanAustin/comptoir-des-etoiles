meta {
  name: 4. Suivi des commandes
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/till/orders
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token_caisse}}
}

script:post-response {
  // Une commande prête, pour « 5. Remise au client »
  if (res.status === 200) {
    const ready = res.body.orders.find(function (o) { return o.status === "ready"; });
    if (ready) {
      bru.setVar("readyOrderUuid", ready.uuid);
    }
  }
}

tests {
  test("la liste est renvoyée (200)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.orders).to.be.an("array");
    // Heure du serveur dans l'en-tête Date, aussi sur une 304
    expect(Date.parse(res.headers.date)).to.be.a("number").and.not.NaN;
  });

  test("numéros et états seulement, ni montant ni article", function () {
    res.body.orders.forEach(function (o) {
      // Numéro de table : pour le filtre « À table » (ni montant ni article)
      expect(Object.keys(o).sort()).to.eql(["createdAt", "displayNumber", "mine", "status", "tableNumber", "updatedAt", "uuid"]);
      expect(["new", "prep", "ready"]).to.include(o.status);
    });
  });
}

docs {
  Commandes en cours de toutes les caisses, pour répondre à un client (« où en est ma commande ? »). `mine` repère les commandes de cette caisse.

  Avec `If-None-Match`, le serveur répond 304 tant que rien n'a changé.
}
